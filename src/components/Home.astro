---
// The site as a set of technical drawings: a cover, one sheet per project, the materials, and contact.
import Base from '../layouts/Base.astro';
import Project from './Project.astro';
import Chars from './Chars.astro';
import { COPY, PROJECTS, SITE, TABS, TOOLS, type Lang } from '../data/content';
import { SHEET } from '../data/sheet';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const s = SHEET[lang];

// Four sheets; the projects share sheet 02 as 02.1, 02.2 and 02.3.
const anchors = ['top', 'project-hc', 'materials', 'contact'];
const pad = (i: number) => String(i + 1).padStart(2, '0');
const total = pad(anchors.length - 1);
// Sheet number of each data-sheet element, in page order: cover, three projects, materials, contact.
const sheetNos = ['01', ...PROJECTS.map((_, i) => `02.${i + 1}`), '03', '04'];
const sheetIndex = [0, ...PROJECTS.map(() => 1), 2, 3];
const groups = TABS.filter((c) => c !== 'all').map((cat) => ({ label: t.stack.tabs[cat], tools: TOOLS.filter((tool) => tool[2] === cat) }));
const activity = 'https://raw.githubusercontent.com/keylorpineda/keylorpineda/output/activity-';
let ni = 0;
const nameWords = s.name
  .toUpperCase()
  .split(' ')
  .map((w) => [...w].map((ch) => ({ ch, i: ni++ })));
const built = new Intl.DateTimeFormat(t.repo.locale, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Costa_Rica' }).format(new Date());
const preview = (p: (typeof PROJECTS)[number]) => {
  const shot = p.ui ?? p.shots[0];
  return shot.key ? `/img/shots/${shot.key}-en-light.webp` : shot.src!;
};
---

<Base lang={lang} t={t}>
  <!-- First visit of the session: the sheet is plotted, then lifted off. -->
  <div class="plotter" data-plotter aria-hidden="true">
    <div class="plot-paper">
      <svg class="plot-frame" data-plot-frame><rect></rect></svg>
      <p class="plot-sheet">{s.plot.title} <b>01</b> / {total}</p>
      <p class="plot-mark" data-plot-mark>KP</p>
      <div class="plot-count"><span data-plot-n>000</span><small>%</small></div>
      <dl class="plot-block">
        <div><dt>{s.plot.drawn}</dt><dd>{s.name}</dd></div>
        <div><dt>{s.plot.set}</dt><dd>{s.plot.setName}</dd></div>
        <div><dt>{s.plot.sheets}</dt><dd>{total}</dd></div>
        <div><dt>{s.plot.scale}</dt><dd>1 : 1</dd></div>
        <div><dt>{s.plot.state}</dt><dd data-plot-state data-ready={s.plot.ready}>{s.plot.plotting}</dd></div>
      </dl>
      <i class="plot-head" data-plot-head><i></i></i>
    </div>
  </div>

  <a class="skip" href="#main">{t.skip}</a>

  <!-- The drawing frame: fixed border, corner readouts, and the sheet index. -->
  <div class="frame" data-sheet-nos={JSON.stringify(sheetNos)} data-sheet-index={JSON.stringify(sheetIndex)}>
    <header class="frame-top" data-bar>
      <a class="mark" href="#top" aria-label={s.name}>
        <span class="mark-kp">KP</span>
        <span class="mark-name">{s.name}</span>
      </a>
      <nav class="index" aria-label={t.nav.menu}>
        {
          s.sheets.map((label, i) => (
            <a href={`#${anchors[i]}`} data-sheet-link={i}>
              <span class="index-n" data-index-n={pad(i)}>{pad(i)}</span>
              <span class="index-l">{label}</span>
            </a>
          ))
        }
      </nav>
      <div class="frame-tools">
        <div class="lang" role="group" aria-label={t.aria.lang}>
          <a href="/" hreflang="en" lang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <a href="/es/" hreflang="es" lang="es" data-lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
        </div>
        <button class="theme-btn" type="button" data-theme-toggle aria-label={t.aria.theme}>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <div class="frame-foot" aria-hidden="true">
      <span class="frame-coords">{s.coords} <b data-clock>--:--</b> {s.local}</span>
      <span class="frame-ruler"><i data-progress></i></span>
      <span class="frame-sheet">
        {s.sheet} <b data-sheet-now>01</b> {s.of} {total}
      </span>
    </div>
  </div>

  <main id="main">
    <!-- 01 COVER -->
    <section class="cover" id="top" data-sheet="0">
      <div class="cover-grid">
        <p class="cover-kicker reveal">{s.block[1][1]} · {s.place}</p>

        <div class="name-wrap" data-lens>
          <h1 class="name chars" data-chars="load" data-name aria-label={s.name}>
            {
              nameWords.map((word, wi) => (
                <>
                  {wi > 0 && <span class="gap" aria-hidden="true" />}
                  <span class="nl" aria-hidden="true">
                    {word.map((c) => (
                      <span class="ch" style={`--i:${c.i}`}>
                        {c.ch}
                      </span>
                    ))}
                  </span>
                </>
              ))
            }
          </h1>
          <div class="name name-ghost" aria-hidden="true">
            {
              nameWords.map((word, wi) => (
                <>
                  {wi > 0 && <span class="gap" />}
                  <span class="nl">
                    {word.map((c) => (
                      <span class="ch" style={`--i:${c.i}`}>
                        {c.ch}
                      </span>
                    ))}
                  </span>
                </>
              ))
            }
          </div>
        </div>

        <p class="lead reveal">
          {s.lead[0]}{' '}
          {
            s.lead.slice(1, 5).map((part, i) => (
              <>
                <span class="callout">{part}</span>
                {i < 3 ? ', ' : ' '}
              </>
            ))
          }
          {s.lead[5]}
        </p>

        <dl class="titleblock reveal">
          {
            s.block.map(([k, v], i) => (
              <div class:list={{ live: i === s.block.length - 1 }}>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
          <div>
            <dt>{s.sheet}</dt>
            <dd>01 / {total}</dd>
          </div>
          <div>
            <dt>Rev.</dt>
            <dd>{built}</dd>
          </div>
        </dl>

        <a class="now reveal" href="#project-hc">
          <span class="now-dot" aria-hidden="true"></span>
          {s.now} <b>HealthyCropping</b>
        </a>
      </div>

      <!-- Register of works: the projects as rows of a drawing register. -->
      <div class="register" data-register>
        <h2 class="label reveal">{s.register}</h2>
        <div class="reg-head" aria-hidden="true">
          {s.cols.map((c) => <span>{c}</span>)}
        </div>
        <ol class="reg-list">
          {
            PROJECTS.map((p, i) => {
              const c = t.projects[p.id as keyof typeof t.projects];
              return (
                <li class="reveal" style={`--d:${i * 80}ms`}>
                  <a class="reg-row" href={`#project-${p.id}`} data-preview={preview(p)}>
                    <span class="reg-n">02.{i + 1}</span>
                    <span class="reg-name">{p.name}</span>
                    <span class="reg-what">{c.kicker}</span>
                    <span class="reg-status">{c.status}</span>
                    <span class="reg-stack">{p.chips.slice(0, 3).join(' · ')}</span>
                    <span class="reg-go" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })
          }
        </ol>
        <div class="reg-preview" aria-hidden="true" data-reg-preview>
          <img alt="" />
        </div>
      </div>
    </section>

    <!-- 02.1-02.3 PROJECT SHEETS -->
    {PROJECTS.map((project, i) => <Project project={project} t={t} lang={lang} index={i} />)}

    <!-- 03 MATERIALS -->
    <section class="sheet materials" id="materials" data-sheet="4">
      <header class="sheet-head reveal">
        <span class="sheet-no">{s.sheet} 03</span>
        <span>{s.materialsSub}</span>
      </header>
      <h2 class="sheet-title chars" data-chars="view" aria-label={s.materials}><Chars text={s.materials} /></h2>

      <table class="table bom reveal">
        <thead>
          <tr>{s.bomCols.map((c) => <th scope="col">{c}</th>)}</tr>
        </thead>
        <tbody>
          {
            groups.map((g, i) => (
              <tr>
                <td class="mono-cell">{pad(i)}</td>
                <th scope="row">{g.label}</th>
                <td>
                  <ul class="parts">
                    {g.tools.map(([, name]) => (
                      <li>{name}</li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h3 class="label reveal" id="certs">{s.stamps}</h3>
      <ul class="stamps">
        {
          t.certs.items.map((c, i) => (
            <li class="reveal" style={`--d:${i * 80}ms`}>
              <a class="stamp" href={SITE.certs} target="_blank" rel="noopener">
                <img src={`/logos/${c.logo}.svg`} alt="" width="22" height="22" loading="lazy" />
                <span class="stamp-org">{c.org}</span>
                <span class="stamp-name">{c.name}</span>
                <span class="stamp-meta">{c.meta}</span>
                <span class="stamp-id">{c.id}</span>
                <span class="stamp-go">
                  {t.certs.verify} <span aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="two">
        <div>
          <h3 class="label reveal">{s.pending}</h3>
          <ol class="pending">
            {
              t.learning.items.map((item, i) => (
                <li class="reveal" style={`--d:${i * 80}ms`}>
                  <span class="mono-cell">R{i + 1}</span>
                  <div>
                    <b>{item.t}</b>
                    <p>{item.d}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <h3 class="label reveal">{s.activity}</h3>
          <a class="activity reveal" href={SITE.github} target="_blank" rel="noopener">
            <img class="only-dark" src={`${activity}calendar-dark.svg`} alt={t.activity.alt2} loading="lazy" />
            <img class="only-light" src={`${activity}calendar-light.svg`} alt={t.activity.alt2} loading="lazy" />
            <img class="only-dark" src={`${activity}stats-dark.svg`} alt={t.activity.alt1} loading="lazy" />
            <img class="only-light" src={`${activity}stats-light.svg`} alt={t.activity.alt1} loading="lazy" />
          </a>
        </div>
      </div>
    </section>

    <!-- 06 CONTACT -->
    <section class="sheet contact" id="contact" data-sheet="5">
      <header class="sheet-head reveal">
        <span class="sheet-no">{s.sheet} 04</span>
        <span>{s.contactKicker}</span>
      </header>
      <h2 class="contact-title chars" data-chars="view" aria-label={s.contactTitle.join(' ')}>
        {s.contactTitle.map((line) => (
          <span class="line">
            <Chars text={line} />
          </span>
        ))}
      </h2>
      <div class="contact-grid">
        <p class="contact-sub reveal">{s.contactSub}</p>
        <div class="reveal">
          <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <div class="contact-links">
            <button class="link-btn" type="button" data-copy={SITE.email} data-copied={t.contact.copied}>
              <span>{t.contact.copy}</span>
            </button>
            <a class="link-btn" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a class="link-btn" href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>{s.footer[0]}</p>
    <p>
      {s.footer[1]} <a href="https://github.com/keylorpineda/portfolio" target="_blank" rel="noopener">{t.source}</a>
    </p>
    <p>© {new Date().getFullYear()} Keylor Pineda · <a href="#top">{s.top} ↑</a></p>
  </footer>
</Base>
