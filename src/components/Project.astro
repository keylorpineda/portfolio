---
// One project, one sheet: a spec block, three numbered figures driven by the scroll,
// the exploded view of its layers, the detail that is specific to it, and its measurements.
import Shot from './Shot.astro';
import Chars from './Chars.astro';
import ProjectDetail from './ProjectDetail.astro';
import Strata from './Strata.astro';
import { repoFacts } from '../data/github';
import { SHEET } from '../data/sheet';
import type { Copy, Lang, Project } from '../data/content';

interface Props {
  project: Project;
  t: Copy;
  lang: Lang;
  index: number;
}
const { project, t, lang, index } = Astro.props;
const s = SHEET[lang];
const p = t.projects[project.id as keyof Copy['projects']];
const facts = await repoFacts(project.code);
const lastCommit = facts && new Intl.DateTimeFormat(t.repo.locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Costa_Rica' }).format(new Date(facts.lastCommit));
const no = String(index + 2).padStart(2, '0');
// Where along the pinned scroll (0 → 1) each figure takes over. The first is there from the start.
const starts = [-1, 0.33, 0.66, 9];
const timing = (i: number) => `--s:${starts[i]};--n:${starts[i + 1]}`;
const kind = (i: number) => {
  const sh = project.shots[i];
  return [sh.fit ?? 'cover', { 'focus-right': sh.focus === 'right', whole: sh.whole, paper: !sh.key && !sh.dark && sh.fit === 'contain' }];
};
const fig = (i: number) => `${s.fig} ${no}.${i + 1}`;
---

<article class="sheet project" id={`project-${project.id}`} data-sheet={index + 1} style={`--tint:${project.tint}`}>
  <header class="sheet-head reveal">
    <span class="sheet-no">{s.sheet} {no}</span>
    <span>{p.kicker}</span>
    {
      facts && (
        <a class="sheet-rev" href={project.code} target="_blank" rel="noopener">
          {t.repo.last} {lastCommit} · {facts.commits.toLocaleString(t.repo.locale)} {t.repo.commits}
        </a>
      )
    }
  </header>

  <h2 class="sheet-title chars" data-chars="view" aria-label={project.name}><Chars text={project.name} /></h2>

  <div class="spec">
    <p class="spec-desc reveal">{p.desc}</p>
    <dl class="spec-table reveal">
      <div>
        <dt>{s.spec.type}</dt>
        <dd>{p.kicker}</dd>
      </div>
      <div>
        <dt>{s.spec.status}</dt>
        <dd><span class="status-dot" aria-hidden="true"></span>{p.status}</dd>
      </div>
      <div>
        <dt>{s.spec.stack}</dt>
        <dd>{project.chips.join(' · ')}</dd>
      </div>
      <div class="spec-links">
        <dt>{s.spec.code}</dt>
        <dd>
          <a href={project.code} target="_blank" rel="noopener">github.com/keylorpineda ↗</a>
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noopener">
              {s.spec.demo} ↗
            </a>
          )}
        </dd>
      </div>
    </dl>
  </div>
  {p.note && <p class="spec-note reveal">{p.note}</p>}

  <!-- Pinned: the plate stays while the scroll brings in its three figures. -->
  <div class="scene scene-project" data-scene="project">
    <div class="scene-pin">
      <div class="figure-grid">
        <figure class="plate">
          <div class="plate-view">
            {
              project.shots.map((sh, i) => (
                <div class:list={['shot', ...kind(i)]} style={timing(i)}>
                  <Shot shot={sh} lang={lang} alt={p.alts[i]} />
                </div>
              ))
            }
          </div>
          <i class="cmark tl" aria-hidden="true"></i>
          <i class="cmark tr" aria-hidden="true"></i>
          <i class="cmark bl" aria-hidden="true"></i>
          <i class="cmark br" aria-hidden="true"></i>
          <figcaption class="plate-cap" aria-hidden="true">
            {project.shots.map((_, i) => <span style={timing(i)}>{fig(i)} — {p.alts[i]}</span>)}
            <span class="plate-url">{project.window}</span>
          </figcaption>
        </figure>

        <ol class="callouts">
          {
            p.steps.map((st, i) => (
              <li class="step" style={timing(i)}>
                <span class="step-n">{fig(i)}</span>
                <h3>{st.t}</h3>
                <p>{st.d}</p>
              </li>
            ))
          }
        </ol>
        <div class="fig-progress" aria-hidden="true">
          {project.shots.map((_, i) => <i style={`--from:${i / 3}`} />)}
        </div>
      </div>
    </div>
  </div>

  <Strata project={project} lang={lang} fig={`${s.fig} ${no}.4 — ${s.exploded}`} />

  <ProjectDetail id={project.id} lang={lang} />

  <div class="measured">
    <h3 class="label reveal">{s.results}</h3>
    <dl class="metrics">
      {
        project.metrics.map((m, i) => (
          <div class="metric reveal" style={`--d:${i * 90}ms`}>
            <dd data-count={m.count} data-dec={m.decimals ?? 0} data-suffix={m.suffix ?? ''}>
              {m.value}
            </dd>
            <dt>{p.metrics[i]}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</article>
